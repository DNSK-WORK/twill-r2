{
    "name": "dnsk-work/twill-r2",
    "description": "Twill fixes for Cloudflare R2 and S3-compatible object storage (URL generation, policy signing, safe deletion)",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/DNSK-WORK/twill-r2",
    "keywords": ["laravel", "twill", "cloudflare-r2", "s3", "media-library", "file-library", "storage", "fine-uploader"],
    "support": {
        "issues": "https://github.com/DNSK-WORK/twill-r2/issues",
        "source": "https://github.com/DNSK-WORK/twill-r2"
    },
    "require": {
        "php": "^8.1",
        "area17/twill": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "DnskWork\\TwillR2\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DnskWork\\TwillR2\\TwillR2ServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
